# instant-mechanic API — environment contract.
# Copy to .env and fill in. Every variable here is validated by src/config/env.ts at import
# time; a missing or malformed value stops the process at boot with a readable list rather
# than failing later on a request.
#
# Never commit .env. This file is the only one that belongs in git.

# ── database ──────────────────────────────────────────────────────────────────
# Pooled connection, used by the running server.
#
# The query params are not decoration. The API reaches Postgres over the public internet,
# so an unbounded await can hang an ops screen indefinitely during an incident:
#   connection_limit=5   caps sockets per instance so one process cannot starve the pooler
#   pool_timeout=10      a request waiting for a free connection gives up after 10s
#   connect_timeout=10   a handshake to a black-holed host fails in 10s
#
# Supabase: Project Settings → Database → Connection string → "Transaction" (port 6543).
# Local compose: postgresql://postgres:postgres@db:5432/instant_mechanic
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10&connect_timeout=10"

# ── auth ──────────────────────────────────────────────────────────────────────
# Signing key for operator session tokens. Minimum 32 characters — the schema rejects
# anything shorter so a dev placeholder cannot reach production.
# Generate one:  openssl rand -base64 48
JWT_SECRET="replace-me-generate-with-openssl-rand-base64-48"

# ── server ────────────────────────────────────────────────────────────────────
# Port the API listens on. Caddy proxies to this; it is never exposed publicly.
PORT=8000

# development | test | production.
# production strips stack traces from error responses and quiets the logger. Getting this
# wrong on a deployed box leaks internal detail to anyone who triggers a 500.
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins. Must be the EXACT scheme+host+port of the
# frontend — never "*", because these responses carry customer PII behind a session cookie
# or token, and a wildcard invites any site to read them.
# Production example: https://instant-mechanic.vercel.app
CORS_ORIGIN="http://localhost:3000"

# ── tests (optional) ──────────────────────────────────────────────────────────
# Where "npm test" writes. Defaults to DATABASE_URL with ?schema=im_test — a dedicated
# Postgres schema beside the real tables, never the development data. The suite truncates
# every table it touches, so it refuses to start if this resolves to the public schema.
# TEST_DATABASE_URL="postgresql://...?schema=im_test"

# ── seeding (optional) ────────────────────────────────────────────────────────
# Only read by `npm run db:seed`. Creates the first ADMIN, which is the only way one can
# exist — POST /api/auth/register is admin-only, so there is no bootstrap without this.
SEED_ADMIN_EMAIL="admin@instantmechanic.com"
SEED_ADMIN_PASSWORD="change-me-min-12-chars"
SEED_ADMIN_NAME="Admin User"

# ── local compose only ────────────────────────────────────────────────────────
# Used by compose.yaml to provision the development Postgres container. Ignored when you
# point DATABASE_URL at a managed database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=instant_mechanic
