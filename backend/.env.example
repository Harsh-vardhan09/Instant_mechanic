# Pooled connection (pgbouncer, 6543) — used by the running server.
# This backend reaches Supabase over the PUBLIC INTERNET, not a private network, so an
# unbounded await can hang an ops screen indefinitely during an incident. The three params
# bound that: connection_limit=5 caps sockets per instance, pool_timeout=10 gives up waiting
# for a free connection, connect_timeout=10 fails a black-holed handshake in 10s.
DATABASE_URL="postgresql://postgres.dvolcnalasohjyatokxj:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10&connect_timeout=10"

# Direct connection (5432, no pooler) — migrations only. pgbouncer transaction mode cannot
# run the DDL and advisory locks Prisma Migrate needs.
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.dvolcnalasohjyatokxj.supabase.co:5432/postgres"

JWT_SECRET="generate-with-openssl-rand-base64-48-min-32-chars"
PORT=8000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
